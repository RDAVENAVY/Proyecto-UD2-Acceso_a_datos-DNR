<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.proyecto_ud2_dnr.Controlador.ListadoEmpleadosController">
   <children>
      <!-- Cabecera -->
      <HBox alignment="CENTER_LEFT" layoutX="24.0" layoutY="21.0" prefHeight="35.0" prefWidth="1150.0" spacing="20.0">
         <children>
            <ComboBox fx:id="cmbOrdenarPor" prefWidth="150.0" promptText="Ordenar por" />
            <ComboBox fx:id="cmbFiltrarPor" prefWidth="150.0" promptText="Filtrar por" />
            
            <Label alignment="CENTER" prefHeight="20.0" prefWidth="380.0" text="LISTADO DE EMPLEADOS">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            
            <Button fx:id="btnBorrarEmpleado" mnemonicParsing="false" prefWidth="120.0" text="Borrar Empleado" />
            <Button fx:id="btnNuevaSeccion" mnemonicParsing="false" prefWidth="120.0" text="Nuevo empleado" />
            <Button fx:id="btnCambiarUsuario" mnemonicParsing="false" prefWidth="120.0" text="Cambiar usuario" />
         </children>
      </HBox>

      <!-- Contenedor principal desplazable para la lista de empleados -->
      <ScrollPane layoutX="14.0" layoutY="67.0" prefHeight="550.0" prefWidth="1170.0">
         <content>
            <!-- Aquí el controlador Java añadirá dinámicamente los empleados -->
            <VBox fx:id="vboxListaEmpleados" prefWidth="1150.0" spacing="10.0" />
         </content>
      </ScrollPane>

      <!-- Botones inferiores -->
      <HBox alignment="CENTER_RIGHT" layoutX="634.0" layoutY="642.0" prefHeight="35.0" prefWidth="540.0" spacing="15.0">
         <children>
            <Button fx:id="btnListadoPaquetes" mnemonicParsing="false" prefWidth="140.0" text="Listado de paquetes" />
            <Button fx:id="btnListadoSecciones" mnemonicParsing="false" prefWidth="140.0" text="Listado de secciones" />
            <Button fx:id="btnListadoVehiculos" mnemonicParsing="false" prefWidth="140.0" text="Listado de vehiculos" />
         </children>
      </HBox>
   </children>
</AnchorPane>